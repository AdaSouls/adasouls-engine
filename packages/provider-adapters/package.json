{
  "name": "@adasouls/provider-adapters",
  "version": "0.1.1",
  "description": "WalletProvider/AccountProvider/ChainAdapter/... interfaces (ADR-006) plus a mock and a real Safe-on-Base-Sepolia implementation -- see docs/09-custody-and-key-management.md.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AdaSouls/adasouls-engine.git",
    "directory": "packages/provider-adapters"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:testnet": "vitest run --config vitest.testnet.config.ts",
    "test:watch": "vitest",
    "deploy:testnet-safe": "tsx scripts/deploy-testnet-safe.ts"
  },
  "dependencies": {
    "@safe-global/api-kit": "^2.5.6",
    "@safe-global/protocol-kit": "^4.1.1",
    "viem": "^2.21.32"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT"
}
